# Copy to .env for local dev. In prod these are injected from a secrets manager.
JAKAL_PROFILE=dev                       # dev | test | stage | prod
JAKAL_DATABASE_URL=sqlite+aiosqlite:///./jakal_v3.db
# JAKAL_DATABASE_URL=postgresql+asyncpg://jakal:pass@localhost:5432/jakal

JAKAL_JWT_ALGORITHM=HS256
JAKAL_JWT_SECRET=change-me-min-32-bytes-xxxxxxxxxxxxxxxx
JAKAL_JWT_ISSUER=jakal-idp
JAKAL_JWT_AUDIENCE=jakal-api

# Envelope/KEK root — REQUIRED in prod (from KMS/HSM), refuses to start without it
JAKAL_MASTER_KEY=change-me-master-key

# Require the PQC signing backend + hybrid verify (REQUIRED true in prod)
JAKAL_CRYPTO_STRICT=false

# Optional; disabled by default so the app boots with no external deps
JAKAL_LLM_ENGINE=disabled

# JAKAL environment — copy to .env and fill values
# PRIMARY LLM is Claude (Anthropic). Ollama is offline/dev fallback only.

LLM_ENGINE=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional offline fallback only:
# LLM_ENGINE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

PQC_PROFILE=commercial
ENABLE_HUMAN_IN_LOOP=True
API_HOST=0.0.0.0
API_PORT=8000

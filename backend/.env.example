# JAKAL Backend Configuration Template
# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. Every placeholder below is exactly that: not a real key.

# General Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ============================================================================
# LLM - ANTHROPIC CLAUDE
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20240620  # Update to your specific model version
CLAUDE_RATE_LIMIT=60  # requests per minute

# Quantum Engine (Qiskit-Aer runs locally with no token; IBM hardware is optional)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum
IBM_BACKEND_NAME=

# Database & Storage
DUCKDB_PATH=./jakal.duckdb

# Security tool wrappers
NMAP_TIMEOUT=120
NUCLEI_TIMEOUT=120
NUCLEI_TEMPLATES_PATH=
SHODAN_API_KEY=your_shodan_api_key_here

# VM Orchestrator: requires a reachable local Docker daemon. No config
# needed beyond having `docker` running -- sandboxes are local-only.

# ============================================================================
# SECURITY / v2.6 GLOBAL SETTINGS & SECURITY
# ============================================================================
# Root secret for: KEK-wrapped encryption key persistence (crypto/encryption_manager.py)
# AND the IAM JWT signing key (dependencies.py). Without this set, both fall
# back to an ephemeral in-memory secret -- fine for a quick local demo, but
# encrypted data and login sessions will NOT survive a process restart.
JAKAL_MASTER_KEY=change_me_to_a_long_random_secret

# Set true to require login on every permission-gated endpoint even before
# any user has been registered yet (see dependencies.py's bootstrap-mode
# docstring for the default, progressive-hardening behavior).
JAKAL_REQUIRE_AUTH=false
JAKAL_JWT_TTL_MINUTES=60

# Enables live Dark Web Monitoring breach checks (haveibeenpwned.com/API/Key).
# Without it, POST /api/darkweb/scan runs but reports "connector not configured"
# instead of fabricating results.
HIBP_API_KEY=
